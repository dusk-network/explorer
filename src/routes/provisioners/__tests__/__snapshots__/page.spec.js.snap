exports[`Provisioners page > should render the Provisioners page, start polling for provisioners and stop the polling when unmounted 1`] = `
<section>
  <!---->
  <div
    class="dusk-card data-card data-card--page"
  >
    <!---->
    <!---->
    <header
      class="data-card__header"
      slot="header"
    >
      <h1
        class="data-card__header-title"
      >
        Provisioners
        
      </h1>
      <!---->
       
      <!---->
    </header>
    
    <!---->
     
    <!---->
    <div
      aria-label="Loading"
      class="dusk-progress-bar data-card__progress-bar"
      role="progressbar"
    >
      <div
        class="dusk-progress-bar__filler dusk-progress-bar__filler--undetermined"
      />
    </div>
    
    <!---->
     
    <!---->
    
  </div>
  
  <!---->
   
  <div
    aria-hidden="true"
    class="dusk-tooltip dusk-tooltip-top dusk-tooltip-info"
    id="provisioners-tooltip"
    role="tooltip"
    style="left: 0px; top: 0px;"
  >
    
  </div>
  <!---->
</section>
`;

