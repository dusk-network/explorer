    <header
      class="data-card__header"
      slot="header"
    >
      <h1
        class="data-card__header-title"
      >
        <span
          aria-hidden="true"
          class="data-card__bracket"
        >
          [
        </span>
         Transaction Details 
        <span
          aria-hidden="true"
          class="data-card__bracket"
        >
          ]
        </span>
      </h1>
       
      <!---->
    </header>
    
    <!---->
     
    <!---->
    <div
      aria-label="Loading"
      class="dusk-progress-bar data-card__progress-bar"
      role="progressbar"
    >
      <div
        class="dusk-progress-bar__filler dusk-progress-bar__filler--undetermined"
      />
    </div>
    
    <!---->
     
    <!---->
    
  </div>
  
  <!---->
</section>
`;

