exports[`Transaction Details > should render the Transaction details page 1`] = `
<section
  class="transaction"
>
  <!---->
  <div
    class="dusk-card data-card transaction-details"
  >
    <!---->
    <!---->
    <header
      class="data-card__header"
      slot="header"
    >
      <h1
        class="data-card__header-title"
      >
        Transaction Details
      </h1>
       
      <!---->
    </header>
    
    <!---->
     
    <!---->
    <div
      aria-label="Loading"
      class="dusk-progress-bar data-card__progress-bar"
      role="progressbar"
    >
      <div
        class="dusk-progress-bar__filler dusk-progress-bar__filler--undetermined"
      />
    </div>
    
    <!---->
     
    <!---->
    
  </div>
  
  <!---->
</section>
`;

