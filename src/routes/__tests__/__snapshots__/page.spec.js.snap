exports[`home page > should render the home page, read the latest chain info again at each new block and only then, and stop when it is destroyed 2`] = `
<section
  class="landing"
>
  <h1
    class="sr-only"
  >
    Dusk Explorer
  </h1>
   
  <article
    class="chain-info"
  >
    <div
      class="statistics-panel"
    >
      <figure
        class="statistics-panel__face"
      >
        <svg
          aria-hidden="true"
          class="nodes-world-map"
          viewBox="0 30 954 410"
        >
          <defs>
            <pattern
              height="10"
              id="vertical-lines"
              patternUnits="userSpaceOnUse"
              width="7"
            >
              <line
                stroke="currentColor"
                stroke-width="1.4"
                x1="3.5"
                x2="3.5"
                y1="0"
                y2="10"
              />
            </pattern>
