// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Transactions List > should render the \`TransactionsList\` component in "compact" mode 1`] = `
<dl
  class="detail-list"
>
  <!---->
  <dt
    class="details-list__term details-list__term--table"
  >
    <div
      class="details-list__term-layout"
    >
      <!---->
       
      ID
      <!---->
    </div>
  </dt>
   
  <dd
    class="details-list__definition details-list__definition--table"
  >
    <!---->
    <a
      class="dusk-anchor dusk-anchor--on-surface transaction-details__list-link"
      href="/some-base-path/transactions/transaction?id=4877687c2dbf154248d3ddee9ba0d81e3431f39056f82a46819da041d4ac0e04"
    >
      <!---->
      4877687c2dbf154248d3ddee9...056f82a46819da041d4ac0e04
      
      <!---->
    </a>
    <!---->
     
    <div
      class="dusk-copy-button"
    >
      <button
        aria-label="Copy transaction ID"
        class="dusk-button dusk-button--type--button dusk-button--variant--secondary dusk-button--size--default dusk-icon-button dusk-copy-button"
        data-tooltip-id="main-tooltip"
        data-tooltip-text="Copy to clipboard"
        type="button"
      >
        <!---->
        <!---->
        <svg
          class="dusk-icon dusk-icon--size--default dusk-button__icon"
          role="graphics-symbol"
          viewBox="0 0 24 24"
        >
          <path
            d="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"
          />
        </svg>
        
        <!---->
         
        <!---->
        <!---->
      </button>
      <!---->
    </div>
    <!---->
    <!---->
  </dd>
  <!---->
   
  <dt
    class="details-list__term details-list__term--table"
  >
    <div
      class="details-list__term-layout"
    >
      <!---->
       
      relative time
      <!---->
    </div>
  </dt>
   
  <dd
    class="details-list__definition details-list__definition--table"
  >
    <time
      class="dusk-relative-time transaction-details__list-timestamp"
      datetime="2024-04-16T06:39:09.000Z"
      slot="definition"
    >
      <!---->
      last month
      
      <!---->
    </time>
    <!---->
  </dd>
  <!---->
   
  <!---->
   
  <dt
    class="details-list__term details-list__term--table"
  >
    <div
      class="details-list__term-layout"
    >
      <!---->
       
      Fee
      <!---->
    </div>
  </dt>
   
  <dd
    class="details-list__definition details-list__definition--table"
  >
    0.000290766 DUSK
    <!---->
  </dd>
  <!---->
   
  <dt
    class="details-list__term details-list__term--table"
  >
    <div
      class="details-list__term-layout"
    >
      <!---->
       
      Status
      <!---->
    </div>
  </dt>
   
  <dd
    class="details-list__definition details-list__definition--table"
  >
    <span
      class="dusk-badge dusk-badge--variant-success transaction-status explorer-badge"
    >
      success
    </span>
    <!---->
  </dd>
  <!---->
   
  <dt
    class="details-list__term details-list__term--table"
  >
    <div
      class="details-list__term-layout"
    >
      <!---->
       
      Type
      <!---->
    </div>
  </dt>
   
  <dd
    class="details-list__definition details-list__definition--table"
  >
    <!---->
    <!---->
    <div
      class="transaction-type"
    >
      <span
        class="transaction-type__privacy"
        data-tooltip-disabled="true"
        data-tooltip-id="main-tooltip"
        data-tooltip-place="top"
        data-tooltip-text="Sender, receiver and amount are visible to everyone"
        data-tooltip-type="info"
      >
        Public
      </span>
      <!---->
       
      <span
        class="dusk-badge dusk-badge--variant-neutral transaction-type__method-badge"
      >
        transfer
      </span>
      <!---->
       
      <!---->
    </div>
    
    
    <!---->
  </dd>
  <!---->
  <!---->
</dl>
`;

