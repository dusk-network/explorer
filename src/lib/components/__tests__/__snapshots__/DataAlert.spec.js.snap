exports[`DataAlert > should render the \`DataAlert\` in the error state 1`] = `
<div
  class="alert alert--error"
>
  <p
    class="alert__title"
  >
    <!---->
    <svg
      class="dusk-icon dusk-icon--size--default"
      role="graphics-symbol"
      viewBox="0 0 24 24"
    >
      <path
        d="M11,15H13V17H11V15M11,7H13V13H11V7M12,2C6.47,2 2,6.5 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20Z"
      />
    </svg>
    
    <!---->
    Couldn't load this.
  </p>
   
  <p
    class="alert__error-message"
  >
    error
  </p>
  <!---->
   
  <button
    class="dusk-button dusk-button--type--button dusk-button--variant--secondary dusk-button--size--small"
    type="button"
  >
    <span
      class="dusk-button__text"
    >
      Try again
    </span>
    <!---->
  </button>
  <!---->
  <!---->
</div>
`;

exports[`DataAlert > should render the \`DataAlert\` in the no data state 1`] = `
